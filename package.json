{
  "name": "workoutpronow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "WorkOutProNow adaptive training platform — deterministic coaching, adaptivity and offline clients",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @myoadapt/db migrate:up",
    "db:migrate:down": "pnpm --filter @myoadapt/db migrate:down",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "local:setup": "tsx scripts/local-setup.ts",
    "local:services": "tsx scripts/local-services.ts",
    "local:client": "pnpm --filter @myoadapt/client-app start"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "dotenv": "^16.4.5",
    "@eslint/js": "^9.7.0",
    "eslint": "^9.7.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "turbo": "^2.0.9",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.3"
  }
}
