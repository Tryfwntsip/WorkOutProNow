# ─────────────────────────────────────────────────────────────
# WorkOutProNow — environment template. Copy to .env for local dev.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development                 # development | staging | production
LOG_LEVEL=debug                      # fatal|error|warn|info|debug|trace

# Database (PostgreSQL 16 + TimescaleDB)
DATABASE_URL=postgres://myoadapt:myoadapt@localhost:5432/myoadapt

# Auth — Auth0 as IdP in staging/prod; local dev issuer for offline dev/CI
AUTH_MODE=local                      # local | auth0
AUTH_JWT_ISSUER=https://myoadapt.dev/
AUTH_JWT_AUDIENCE=myoadapt-api
# Local dev issuer signing secret (HS256) — DEV/CI ONLY, never in prod
AUTH_LOCAL_DEV_SECRET=dev-only-insecure-secret-change-me
# Auth0 (used when AUTH_MODE=auth0)
AUTH0_DOMAIN=
AUTH0_JWKS_URI=

# Sessions
SESSION_REFRESH_TTL_DAYS=30

# Service ports
IDENTITY_SERVICE_PORT=4001
USER_PROFILE_SERVICE_PORT=4002
ENGINE_SERVICE_PORT=4003
CLIENT_PORT=3000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=myoadapt
METRICS_ENABLED=true
